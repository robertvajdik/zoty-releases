Options -Indexes
AddDefaultCharset UTF-8
<FilesMatch "^(lib|config|config\.sample)\.php$|\.(sql|sqlite|md|properties|log)$">
  Require all denied
</FilesMatch>

# Clean URLs: /admin/edit -> admin/edit.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Generated files
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^feed\.xml$ feed.php [L]
  # Redirect old *.php URLs to the extensionless form (GET only, keeps POSTs working)
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.php[\s?]
  RewriteCond %1 !(^|/)index$
  RewriteRule ^ /%1 [R=301,L,NE,QSA]
  # Serve extensionless URL from the matching .php file
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
